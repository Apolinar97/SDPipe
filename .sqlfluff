[sqlfluff]
dialect = postgres
templater = dbt
max_line_length = 120
exclude_rules = capitalisation.identifiers, structure.subquery, structure.column_order

[sqlfluff:templater:dbt]
project_dir = sdpipe_transforms
profiles_dir = ~/.dbt

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:aliasing.column]
aliasing = explicit
